rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 活動情報: 誰でも閲覧可、書き込みは管理者(ログイン済み)のみ
    match /activities/{activityId} {
      allow read: if true;
      allow write: if request.auth != null;

      // 内部メモ: 職員(ログイン済み)のみ閲覧・編集可。一般には公開されない
      match /internal/{docId} {
        allow read, write: if request.auth != null;
      }

      // 感想・改善点: 誰でも閲覧・新規投稿可。更新・削除は不可(投稿の改ざん防止)
      match /feedbacks/{feedbackId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['name', 'comment', 'createdAt'])
                       && request.resource.data.comment is string
                       && request.resource.data.comment.size() > 0
                       && request.resource.data.comment.size() < 1000
                       && request.resource.data.name is string
                       && request.resource.data.name.size() < 100;
        allow update, delete: if request.auth != null;
      }
    }

    // 設定情報(場所リスト・活動内容・機材): 誰でも読み取り可、書き込みは管理者のみ
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ===== 緑地管理システム（別アプリ・同一プロジェクトに相乗り） =====
    // 予算情報を含む業務データのため、係ごとの専用アカウントのみ読み書き可
    function isKoen() {
      return request.auth != null && request.auth.token.email == 'hwatanabe829+koen@gmail.com';
    }
    function isMidori() {
      return request.auth != null && request.auth.token.email == 'hwatanabe829+midori@gmail.com';
    }

    // 公園係のデータ領域
    match /ryokuchi_koen_greens/{gsId} {
      allow read, write: if isKoen();
      match /photos/{photoId} {
        allow read, write: if isKoen();
      }
    }
    match /ryokuchi_koen_settings/{docId} {
      allow read, write: if isKoen();
    }

    // みどりの係のデータ領域
    match /ryokuchi_midori_greens/{gsId} {
      allow read, write: if isMidori();
      match /photos/{photoId} {
        allow read, write: if isMidori();
      }
    }
    match /ryokuchi_midori_settings/{docId} {
      allow read, write: if isMidori();
    }

    // 旧・共有データ（みどりの係へ引き継ぎ後はバックアップとして残置）
    // 移行期間中は旧バージョンのアプリも動くよう従来通りログイン済みなら読み書き可。
    // 引き継ぎ完了後は read のみ isMidori() に絞ってよい
    match /ryokuchi_greens/{gsId} {
      allow read, write: if request.auth != null;
      match /photos/{photoId} {
        allow read, write: if request.auth != null;
      }
    }
    match /ryokuchi_settings/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
